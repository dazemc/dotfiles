alias ls='ls --color=auto'
alias grep='grep --color=auto'
PS1='[\u@\h \W]\$ '
alias htop='btop'
alias realloc='sudo mount -o remount,size=100% /tmp'
alias dealloc='sudo mount -o remount,size=50% /tmp'
# shows all tracked configs for installed pacakges
alias pacconfig='pacman -Qii | awk '\''/\[modified\]/ {print $(NF - 1)}'\'''
# full explicit snapshot; review the diff before committing it
alias pacback='bash ~/GitHub/dotfiles/arch/backup.sh'
alias idfstart=idfsource
alias lspread='bash ~/GitHub/dotfiles/shell/bash/lsp_util.sh'
alias dotfiles='cd ~/GitHub/dotfiles/'
# BAT
alias batlsblk='lsblk | bat -l conf'
alias batfree='free -h | bat -l meminfo'
alias cls='clear && ls'
alias espconfigure='idf.py -B build.clang -D IDF_TOOLCHAIN=clang reconfigure && ln -sf build.clang/compile_commands.json .'
alias espinit='idfsource'
